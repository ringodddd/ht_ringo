# 复制为 .env 后按需填写。密钥留在服务器上时，网页里可以不填 Key。

# 监听地址。只给自己用时保持 127.0.0.1。
HOST=127.0.0.1
PORT=8787

# OpenAI 兼容接口。Base 一般以 /v1 结尾。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选。设置后，所有 /api 请求都要带 Authorization: Bearer <token>
APP_TOKEN=

# 可选。Netscape 格式的 YouTube cookies，给 yt-dlp 用。
# YT_COOKIES=/absolute/path/youtube-cookies.txt

# 可选。yt-dlp 拉不到字幕时再试的 Invidious 实例，逗号分隔，不要末尾斜杠。
# INVIDIOUS_INSTANCES=https://yewtu.be,https://inv.nadeko.net

# 设为 1 时不调用模型，只在译文前加上【译】，用来预览界面。
MUYI_MOCK_TRANSLATE=0
